# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Supabase service_role key (from Project Settings > API). Use the SERVICE ROLE key so the backend can run the scheduled job processor.
SUPABASE_KEY=

# Secret used to sign auth tokens (any long random string, e.g. generated with `openssl rand -hex 32`)
JWT_SECRET=

# Optional: CORS allow-list for the frontend origin (defaults to * if unset)
# CLIENT_ORIGIN=https://your-app.vercel.app

# Port (defaults to 8080)
# PORT=8080

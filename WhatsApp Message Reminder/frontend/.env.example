# Base URL of the backend API, WITHOUT a trailing slash.
#
# Vite inlines this at BUILD time, not at runtime -- so it must be set wherever
# you run `npm run build` (on Vercel: Project Settings > Environment Variables).
# If it is missing in production the app calls /api on its own domain and every
# request 404s.
#
# Leave it unset for local development: `npm run dev` proxies /api to
# http://localhost:8080 (see vite.config.js).
VITE_API_URL=https://your-backend.up.railway.app

# Optional: point the dev proxy somewhere other than localhost:8080.
# VITE_DEV_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. NEVER commit .env -- it holds a key
# that can read and write your entire database.
# ---------------------------------------------------------------------------

# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Supabase SERVICE ROLE key (Project Settings > API).
# This key bypasses row level security, which is why it must stay on the server
# and never appear in the frontend or in a git commit.
SUPABASE_KEY=

# Secret used to sign auth tokens. Must be at least 32 characters -- the server
# refuses to start in production with anything shorter.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset only for local development; unset means "allow any origin".
# CLIENT_ORIGIN=https://your-app.vercel.app,https://www.your-domain.com

# Where the logged-in WhatsApp browser profile is stored.
# On Railway this MUST point at a mounted volume, otherwise every redeploy wipes
# the login and you have to scan the QR code again.
#   Railway > your service > Variables + Volumes > mount a volume at /data
# WA_SESSION_PATH=/data/wwebjs_auth

# Numbers entered without a country code are assumed to be from here.
# 968 = Oman, 971 = UAE, 966 = Saudi Arabia.
# DEFAULT_COUNTRY_CODE=968

# Timezone used to render {date}, {time} and {day} inside message templates.
# APP_TIMEZONE=Asia/Muscat

# ---------------------------------------------------------------------------
# Password-reset emails
# ---------------------------------------------------------------------------
# Without these, "Forgot your password?" still works but the reset link is
# written to the server log instead of being emailed. Anyone with log access can
# read it, which is fine for testing and not fine for staff use.
#
# Get a key free at https://resend.com (3,000 emails/month).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address. Resend gives you onboarding@resend.dev to test with, but
# it only delivers to your own signup address -- verify ifdc.om in Resend to
# send to colleagues.
# MAIL_FROM=WhatsApp Reminders <reminders@ifdc.om>

# The frontend address, used to build the link inside the reset email.
# Defaults to the first entry in CLIENT_ORIGIN, which is usually correct.
# APP_URL=https://whatsapp-reminder.vercel.app

# Port the server listens on (defaults to 8080).
# PORT=8080

# Only needed if Chromium is installed somewhere non-standard.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# NODE_ENV=production
